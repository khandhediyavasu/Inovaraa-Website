# Copy this file to .env.local and fill in the values. .env.local is never committed.
# Restart the server after changing it.

# ---------------------------------------------------------------------------
# Email: every form submission is emailed to MAIL_TO through this SMTP account.
# Use the SMTP settings of the mailbox that hosts info@inovaraa.com, e.g.
#   Google Workspace: smtp.gmail.com, port 465, and an App Password (not the normal password)
#   Microsoft 365:    smtp.office365.com, port 587, SMTP_SECURE=false
#   Zoho Mail:        smtp.zoho.in (India) or smtp.zoho.com, port 465
#   Hostinger:        smtp.hostinger.com, port 465
#   GoDaddy email:    smtpout.secureserver.net, port 465 (what inovaraa.com uses)
# Wrap the password in single quotes if it contains # or $, e.g. SMTP_PASS='abc#123'
# If these are empty, submissions are still saved to Excel, just not emailed.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@inovaraa.com
SMTP_PASS=

# Who receives the notifications, and who they appear to come from
MAIL_TO=info@inovaraa.com
MAIL_FROM="Inovaraa Website <info@inovaraa.com>"

# ---------------------------------------------------------------------------
# Excel: each submission becomes one row in this workbook (created on first use).
# Default: <project>/data/leads.xlsx. Use an absolute path to keep it elsewhere.
# ---------------------------------------------------------------------------
# LEADS_FILE=/var/www/inovaraa/data/leads.xlsx
LEADS_TIMEZONE=Asia/Kolkata

# Secret for downloading the workbook from the live site:
#   https://inovaraa.com/api/leads?key=<LEADS_ADMIN_KEY>
# Use a long random value. Leave empty to disable the download link.
LEADS_ADMIN_KEY=
